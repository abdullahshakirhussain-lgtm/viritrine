PORT=4000
JWT_SECRET=replace-me-with-a-long-random-string
NODE_ENV=development
ADMIN_EMAIL=admin@vitrine.lk
ADMIN_PASSWORD=admin

# ── Phone-OTP SMS (Notify.lk). Unset = OTP codes print to the server console. ──
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# ── AI product authoring (photo → draft fields). Unset key = feature disabled. ──
# Provider is switchable without code changes: openai (default) | anthropic
AI_PROVIDER=openai
# OpenAI (default). Set OPENAI_MODEL to the exact current model id if it differs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Anthropic (used only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
